# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is git-ignored; only this `.env.example` (no values) is tracked.
#
# This file is also docker-compose.yml's source of truth: `docker compose`
# automatically reads a `.env` in the same directory as the compose file for
# `${VAR}` substitution, so POSTGRES_*/MINIO_* below feed both the containers
# and the connection strings further down — change them here only, never in
# docker-compose.yml itself.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Consumed directly by docker-compose.yml's postgres service.
POSTGRES_USER="stages"
POSTGRES_PASSWORD="stages"
POSTGRES_DB="stages"
# Prisma connection string. Port 5433 matches docker-compose.yml (not 5432,
# to avoid clashing with a locally-installed Postgres on dev machines).
# Expanded from the POSTGRES_* values above (see ConfigModule's
# expandVariables in apps/api/src/app.module.ts).
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"
# Production only (ADR-0022): a separate, migrate-only credential the API
# container's entrypoint uses for `prisma migrate deploy`, so the runtime
# Nest process (DATABASE_URL above) never holds schema-altering rights.
# Read only by apps/api/docker-entrypoint.sh, never by the Nest app itself —
# unset locally, the entrypoint falls back to DATABASE_URL.
DATABASE_MIGRATE_URL=

# --- Auth ------------------------------------------------------------------
# Secret used to sign JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=
# Access / refresh token lifetimes.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Object storage (S3 / MinIO) ------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="fr-par"
S3_BUCKET="stages-files"
# Consumed directly by docker-compose.yml's minio service. MinIO's root
# user/password double as the S3 access key/secret for local dev.
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
S3_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
S3_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
# Use path-style URLs for MinIO (true) vs AWS S3 (false).
S3_FORCE_PATH_STYLE="true"

# --- Email (Scaleway Transactional Email, ADR-0026) ------------------------
# Account/project/domain provisioning is tracked out-of-band (issue #67):
# these are left blank here since no real Scaleway account exists yet.
# MailerService is DI-overridden with a stub in every e2e spec that reaches
# it, so a blank secret key never causes a real send attempt in tests.
MAILER_SCW_SECRET_KEY=
MAILER_SCW_PROJECT_ID=
# Must be a sender address on a domain Scaleway TEM has verified (SPF/DKIM) —
# not necessarily the university's own domain. Placeholder until that's
# provisioned.
MAILER_FROM_EMAIL="no-reply@example.org"
MAILER_FROM_NAME="Gestion des stages"

# --- API -------------------------------------------------------------------
API_PORT="3000"
# Comma-separated allowed origins for CORS (the web app URL).
CORS_ORIGINS="http://localhost:5173"

# --- Web (Vite) ------------------------------------------------------------
# Only VITE_-prefixed vars are exposed to the browser bundle.
# NEVER put a secret behind a VITE_ prefix.
VITE_API_BASE_URL="http://localhost:3000"
