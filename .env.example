# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is git-ignored; only this `.env.example` (no values) is tracked.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Prisma connection string. Port 5433 matches docker-compose.yml (not 5432,
# to avoid clashing with a locally-installed Postgres on dev machines).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/stages?schema=public"

# --- Auth ------------------------------------------------------------------
# Secret used to sign JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=
# Access / refresh token lifetimes.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Object storage (S3 / MinIO) ------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="stages-files"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Use path-style URLs for MinIO (true) vs AWS S3 (false).
S3_FORCE_PATH_STYLE="true"

# --- API -------------------------------------------------------------------
API_PORT="3000"
# Comma-separated allowed origins for CORS (the web app URL).
CORS_ORIGINS="http://localhost:5173"

# --- Web (Vite) ------------------------------------------------------------
# Only VITE_-prefixed vars are exposed to the browser bundle.
# NEVER put a secret behind a VITE_ prefix.
VITE_API_BASE_URL="http://localhost:3000"
